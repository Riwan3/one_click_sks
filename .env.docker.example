# Salin ke .env di server:  cp .env.docker.example .env
# Wajib diganti: APP_DOMAIN + APP_URL, APP_KEY, DB_PASSWORD, DB_ROOT_PASSWORD, HO_API_TOKEN.

APP_NAME="One Click"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Domain (DNS A record sudah mengarah ke IP server, port 80 & 443 terbuka) -> HTTPS otomatis oleh Caddy.
# Kosongkan APP_DOMAIN untuk sementara akses lewat IP (HTTP), dan isi APP_URL=http://IP-SERVER.
APP_DOMAIN=oneclick.contoh.co.id
APP_URL=https://oneclick.contoh.co.id

# Pintu depan (pilih salah satu):
#  - Server berisi BANYAK aplikasi (disarankan) -> kosongkan COMPOSE_PROFILES; HTTPS diurus Caddy bersama di infra/edge
#      (lihat infra/edge/README.md). APP_DOMAIN tidak dipakai di mode ini; domain diatur di infra/edge/sites/*.caddy.
#  - Server hanya untuk aplikasi ini, port 80/443 kosong -> COMPOSE_PROFILES=caddy (Caddy di compose ini).
#  - Server sudah punya Apache/Nginx -> kosongkan COMPOSE_PROFILES; arahkan web server itu ke http://127.0.0.1:APP_FORWARD_PORT.
COMPOSE_PROFILES=
APP_FORWARD_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Database MySQL di container "mysql" (docker-compose.yml). DB_HOST jangan diubah.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=oneclick
DB_USERNAME=oneclick
DB_PASSWORD=ganti-password-kuat
DB_ROOT_PASSWORD=ganti-password-root-kuat
DB_FORWARD_PORT=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true bila memakai HTTPS (APP_DOMAIN diisi).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Notifikasi push (FCM): taruh file JSON service account Firebase di folder secrets/ (di server), lalu biarkan path ini.
# File tidak ada = push dimatikan tanpa error.
FCM_CREDENTIALS=/app/secrets/firebase-credentials.json

# External API (HO / Web Lain)
HO_API_URL=
HO_API_TOKEN=

# Cetak PDF (Browsershot): path Chromium/Node sudah diatur di image Docker — biarkan baris BROWSERSHOT_* tidak ada.
